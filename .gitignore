# App sources (Clew and yaqatw) are cloned/built by the pipeline, never committed
.sources/
/clew/
/yaqatw/
sites/*/
sites.local.json

# Build-time settings for each app (copied from the apps' own .env; never committed)
env/*
!env/README.md

# Dependencies
node_modules/

# Build / packaging output
dist/
out/
release/

# Local certificates
certs/
*.pem
*.key

# Env and secrets
.env
.env.*
!.env.example

# A profile folder named literally "%TEMP%": what --user-data-dir=%TEMP%\... becomes in a shell
# that does not expand %TEMP% (Git Bash). Never data to keep in Git.
/%TEMP%/

# Logs and OS/editor files
*.log
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# AI assistants' development prompts, notes and handovers: never in Git
# Rule: everything AI-development related (prompts, notes, plans, handovers, scratch
# scripts) goes in private/. Only files a tool must find at a fixed path stay outside it.
private/
clew-desktop-prompt.md
*-prompt.md
CLAUDE.md
CLAUDE.local.md
.claude/
AGENTS.md
GEMINI.md
.gemini/
.cursor/
.cursorrules
.windsurfrules
.aider*
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
handover*.md

# Clew tools built by npm run build:tools (shipped as resources/tools)
tools-dist/
# Dictation packages made by npm run package:dictation, for the clew-tools release
release-dictation/
