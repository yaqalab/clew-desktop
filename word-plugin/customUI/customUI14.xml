<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="Ribbon_OnLoad">
  <ribbon>
    <tabs>
      <!-- Before Help, as Zotero's tab: before Add-ins (there in every Word since 2010, usually
           hidden, just before Help). Help itself is newer: older Words have no TabHelp. -->
      <tab id="yaqatwTab" label="Yaqatw" insertBeforeMso="TabAddIns">
        <!-- Icons are Office's own (imageMso), grey with one accent colour like Word's. A name
             Office does not have shows an empty space and no error: check new ones in Word. -->
        <!-- Shown for analysis documents only (Ribbon.bas): a document without a type has Clew Desktop alone. -->
        <group id="yaqatwCoding" label="Coding" tag="analyze" getVisible="Ribbon_GetVisible">
          <dynamicMenu id="yaqatwApply" label="Apply code" size="large" imageMso="Highlight"
                       screentip="Apply a code"
                       supertip="Codes the selected text: your codes, the ones you used last first."
                       getContent="Ribbon_CodesMenu" invalidateContentOnDrop="true"/>
          <button id="yaqatwFind" label="Find code" size="large" imageMso="ResearchPane"
                  screentip="Find a code"
                  supertip="Type to find a code, Enter applies it to the selected text."
                  onAction="Ribbon_PickCode"/>
          <button id="yaqatwNew" label="New code" size="large" imageMso="NameDefine"
                  screentip="New code"
                  supertip="Creates a code (name, colour, description) and applies it to the selected text."
                  onAction="Ribbon_NewCode"/>
          <button id="yaqatwInVivo" label="In vivo" size="large" imageMso="QuickStylesGallery"
                  screentip="In vivo code"
                  supertip="Creates a code named after the selected text and applies it."
                  onAction="Ribbon_InVivo"/>
          <button id="yaqatwInfo" label="Highlight info" size="large" imageMso="ReviewNewComment"
                  screentip="Highlight info"
                  supertip="The coded passage at the cursor: its text, translation, notes and codes."
                  onAction="Ribbon_HighlightInfo"/>
        </group>
        <!-- Shown for writing documents only. The tag of each
             Insert button is what the insert window searches first. -->
        <group id="yaqatwWriting" label="Writing" tag="write" getVisible="Ribbon_GetVisible">
          <button id="yaqatwInsertQuote" label="Insert quote" size="large" imageMso="CitationInsert" tag="highlights"
                  screentip="Insert a quote"
                  supertip="Type to find a coded passage; Enter inserts it at the cursor as a quote, linked to its source."
                  onAction="Ribbon_Insert"/>
          <button id="yaqatwInsertArtifact" label="Insert artifact" size="large" imageMso="PictureInsertMenu" tag="artifacts"
                  screentip="Insert an artifact"
                  supertip="Type to find an artifact; Enter inserts its picture or its interpretation at the cursor."
                  onAction="Ribbon_Insert"/>
          <button id="yaqatwInsertAny" label="Find and insert" size="large" imageMso="ResearchPane" tag="all"
                  screentip="Find and insert"
                  supertip="Type to find a quote, an artifact, a note, a table or a figure, and insert it at the cursor."
                  onAction="Ribbon_Insert"/>
          <button id="yaqatwRefresh" label="Refresh" size="large" imageMso="Refresh"
                  screentip="Refresh quotes, figures and tables"
                  supertip="Updates every linked quote, figure and table in the document from its source."
                  onAction="Ribbon_RefreshCitations"/>
          <button id="yaqatwUnlink" label="Unlink all" size="large" imageMso="HyperlinkRemove"
                  screentip="Unlink all"
                  supertip="Keeps the quotes, figures and tables as they are, without their links: Refresh no longer updates them."
                  onAction="Ribbon_UnlinkCitations"/>
        </group>
        <group id="yaqatwClew" label="Clew Desktop">
          <!-- image: customUI/images/yaqatw.png, yaqatw's own logo (build.ps1 packs it). -->
          <button id="yaqatwOpen" label="Open Yaqatw" size="large" image="yaqatw"
                  screentip="Open Yaqatw for this document"
                  supertip="Opens Yaqatw in a Clew Desktop window, working on this document."
                  onAction="Ribbon_Open"/>
          <button id="yaqatwConnect" label="Connection" size="large" imageMso="HyperlinkInsert"
                  screentip="Connection to Clew Desktop"
                  supertip="Shows whether Yaqatw for Word is connected to Clew Desktop, and connects it again if needed."
                  onAction="Ribbon_Connect"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
  <!-- Word's right-click menus on text, in a list and on a misspelled word, in analysis
       documents only (coding is the job there; other documents see Word's menus unchanged):
       Apply code (as in the ribbon, with In vivo); then, in a coded passage only
       (Ribbon_PassageVisible), Add to category (its codes into a category,
       Ribbon_CategoriesMenu), Add to relationship (into a relationship's instance,
       Ribbon_RelationshipsMenu; only when the document's Yaqatw can, Ribbon_RelationsVisible)
       and Highlight info (the passage's hub: tags, Manage, Remove highlight).
       Before Cut in each: first in the text and list menus; in the misspelled-word one, after
       Word's Spelling submenu (where its suggestions are; transcripts in other languages are
       underlined throughout, so that menu is often the one shown). A separator after them,
       before Cut: one cannot be hidden, so in other documents it stands beside Word's own above
       the entries, and Word draws the two as one. Ids are unique in the whole file: each menu
       has its own (Ribbon_CodesMenu, Ribbon_CategoriesMenu, Ribbon_RelationshipsMenu read them). -->
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <dynamicMenu id="yaqatwCtxApply" label="Apply code" imageMso="Highlight" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_GetVisible" getContent="Ribbon_CodesMenu" invalidateContentOnDrop="true"/>
      <dynamicMenu id="yaqatwCtxCat" label="Add to category" imageMso="CategorizeMenu" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_PassageVisible" getContent="Ribbon_CategoriesMenu" invalidateContentOnDrop="true"/>
      <dynamicMenu id="yaqatwCtxRel" label="Add to relationship" imageMso="SmartArtInsert" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_RelationsVisible" getContent="Ribbon_RelationshipsMenu" invalidateContentOnDrop="true"/>
      <button id="yaqatwCtxInfo" label="Highlight info" imageMso="ReviewNewComment" tag="analyze" insertBeforeMso="Cut"
              getVisible="Ribbon_PassageVisible" onAction="Ribbon_HighlightInfo"/>
      <menuSeparator id="yaqatwCtxSep" insertBeforeMso="Cut"/>
    </contextMenu>
    <contextMenu idMso="ContextMenuList">
      <dynamicMenu id="yaqatwCtxApplyList" label="Apply code" imageMso="Highlight" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_GetVisible" getContent="Ribbon_CodesMenu" invalidateContentOnDrop="true"/>
      <dynamicMenu id="yaqatwCtxCatList" label="Add to category" imageMso="CategorizeMenu" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_PassageVisible" getContent="Ribbon_CategoriesMenu" invalidateContentOnDrop="true"/>
      <dynamicMenu id="yaqatwCtxRelList" label="Add to relationship" imageMso="SmartArtInsert" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_RelationsVisible" getContent="Ribbon_RelationshipsMenu" invalidateContentOnDrop="true"/>
      <button id="yaqatwCtxInfoList" label="Highlight info" imageMso="ReviewNewComment" tag="analyze" insertBeforeMso="Cut"
              getVisible="Ribbon_PassageVisible" onAction="Ribbon_HighlightInfo"/>
      <menuSeparator id="yaqatwCtxSepList" insertBeforeMso="Cut"/>
    </contextMenu>
    <contextMenu idMso="ContextMenuSpell">
      <dynamicMenu id="yaqatwCtxApplySpell" label="Apply code" imageMso="Highlight" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_GetVisible" getContent="Ribbon_CodesMenu" invalidateContentOnDrop="true"/>
      <dynamicMenu id="yaqatwCtxCatSpell" label="Add to category" imageMso="CategorizeMenu" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_PassageVisible" getContent="Ribbon_CategoriesMenu" invalidateContentOnDrop="true"/>
      <dynamicMenu id="yaqatwCtxRelSpell" label="Add to relationship" imageMso="SmartArtInsert" tag="analyze" insertBeforeMso="Cut"
                   getVisible="Ribbon_RelationsVisible" getContent="Ribbon_RelationshipsMenu" invalidateContentOnDrop="true"/>
      <button id="yaqatwCtxInfoSpell" label="Highlight info" imageMso="ReviewNewComment" tag="analyze" insertBeforeMso="Cut"
              getVisible="Ribbon_PassageVisible" onAction="Ribbon_HighlightInfo"/>
      <menuSeparator id="yaqatwCtxSepSpell" insertBeforeMso="Cut"/>
    </contextMenu>
  </contextMenus>
</customUI>
