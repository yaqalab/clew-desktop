<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
  <ribbon>
    <tabs>
      <tab id="yaqatwTab" label="Yaqatw">
        <group id="yaqatwClew" label="Clew Desktop">
          <button id="yaqatwOpen" label="Open Yaqatw" size="large" imageMso="FileOpen"
                  screentip="Open Yaqatw for this document"
                  supertip="Opens Yaqatw in a Clew Desktop window, working on this document."
                  onAction="Ribbon_Open"/>
          <button id="yaqatwConnect" label="Connection" size="large" imageMso="HyperlinkInsert"
                  screentip="Connection to Clew Desktop"
                  supertip="Shows whether Yaqatw for Word is connected to Clew Desktop, and connects it again if needed."
                  onAction="Ribbon_Connect"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
