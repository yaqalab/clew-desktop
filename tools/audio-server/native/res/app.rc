// Icons: res/make_icons.py composes them from Clew's brand files (packages/kit/brand).
// Texts are set at run time from src/win/strings.cpp (English or Japanese); the ones here are
// placeholders for the resource editor only.
#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

IDI_APP       ICON "icons/app.ico"
IDI_TRAY_ON   ICON "icons/tray-on.ico"
IDI_TRAY_OFF  ICON "icons/tray-off.ico"
IDI_TRAY_BUSY ICON "icons/tray-busy.ico"
IDI_TRAY_ON_DARK   ICON "icons/tray-on-dark.ico"
IDI_TRAY_OFF_DARK  ICON "icons/tray-off-dark.ico"
IDI_TRAY_BUSY_DARK ICON "icons/tray-busy-dark.ico"

IDD_SETTINGS DIALOGEX 0, 0, 340, 368
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Clew audio server"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    // Page "Audio files" (shown and hidden by IDC_TABS, tray_win.cpp)
    LTEXT           "status", IDC_STATUS, 10, 24, 262, 18
    PUSHBUTTON      "Stop", IDC_STARTSTOP, 278, 22, 52, 14

    GROUPBOX        "Folder", IDC_G_FOLDER, 7, 43, 326, 30
    EDITTEXT        IDC_FOLDER, 14, 54, 208, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse", IDC_BROWSE, 226, 54, 52, 14
    PUSHBUTTON      "Open", IDC_OPENFOLDER, 281, 54, 45, 14

    GROUPBOX        "Connection", IDC_G_CONN, 7, 76, 326, 74
    LTEXT           "Port", IDC_L_PORT, 14, 89, 40, 10
    EDITTEXT        IDC_PORT, 58, 87, 42, 14, ES_NUMBER
    LTEXT           "Hours", IDC_L_HOURS, 120, 89, 150, 10
    EDITTEXT        IDC_HOURS, 284, 87, 42, 14, ES_NUMBER
    LTEXT           "Origins", IDC_L_ORIGINS, 14, 104, 312, 18
    EDITTEXT        IDC_ORIGINS, 14, 123, 312, 22, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    GROUPBOX        "Secret", IDC_G_SECRET, 7, 153, 326, 44
    EDITTEXT        IDC_SECRET, 14, 164, 150, 14, ES_AUTOHSCROLL | ES_READONLY | ES_PASSWORD
    PUSHBUTTON      "Show", IDC_SHOW, 168, 164, 46, 14
    PUSHBUTTON      "Copy", IDC_COPY, 217, 164, 46, 14
    PUSHBUTTON      "New", IDC_NEWSECRET, 266, 164, 60, 14
    LTEXT           "hint", IDC_L_SECRET, 14, 181, 312, 14

    GROUPBOX        "Conversion", IDC_G_CONVERT, 7, 200, 326, 92
    AUTOCHECKBOX    "Convert", IDC_CONVERT, 14, 211, 312, 18, BS_MULTILINE | BS_TOP
    AUTOCHECKBOX    "Prepare", IDC_PREPARE, 14, 230, 312, 10
    LTEXT           "ffmpeg", IDC_L_FFMPEG, 14, 246, 66, 10
    EDITTEXT        IDC_FFMPEG, 82, 244, 140, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse", IDC_FFBROWSE, 226, 244, 52, 14
    PUSHBUTTON      "Find", IDC_FFFIND, 281, 244, 45, 14
    LTEXT           "hint", IDC_L_FFHINT, 82, 260, 244, 10
    LTEXT           "Cache", IDC_L_CACHE, 14, 275, 66, 10
    EDITTEXT        IDC_CACHEMB, 82, 273, 46, 14, ES_NUMBER
    LTEXT           "used", IDC_CACHEUSED, 134, 275, 120, 10
    PUSHBUTTON      "Clear", IDC_CLEARCACHE, 258, 273, 68, 14

    // Page "Dictation" (docs/28 section 3.4)
    LTEXT           "status", IDC_STT_STATUS, 10, 24, 262, 18, NOT WS_VISIBLE
    PUSHBUTTON      "Start", IDC_STT_STARTSTOP, 278, 22, 52, 14, NOT WS_VISIBLE

    GROUPBOX        "Model", IDC_G_STT_MODEL, 7, 45, 326, 56, NOT WS_VISIBLE
    AUTORADIOBUTTON "small", IDC_STT_SMALL, 14, 57, 248, 17, BS_MULTILINE | BS_TOP | WS_GROUP | WS_TABSTOP | NOT WS_VISIBLE
    PUSHBUTTON      "Download", IDC_STT_DL_SMALL, 268, 56, 58, 14, NOT WS_VISIBLE
    AUTORADIOBUTTON "turbo", IDC_STT_TURBO, 14, 78, 248, 17, BS_MULTILINE | BS_TOP | NOT WS_VISIBLE
    PUSHBUTTON      "Download", IDC_STT_DL_TURBO, 268, 77, 58, 14, NOT WS_VISIBLE

    GROUPBOX        "Models folder", IDC_G_STT_FOLDER, 7, 104, 326, 44, NOT WS_VISIBLE
    EDITTEXT        IDC_STT_FOLDER, 14, 115, 208, 14, ES_AUTOHSCROLL | ES_READONLY | NOT WS_VISIBLE
    PUSHBUTTON      "Change", IDC_STT_CHANGE, 226, 115, 52, 14, NOT WS_VISIBLE
    PUSHBUTTON      "Open", IDC_STT_OPENFOLDER, 281, 115, 45, 14, NOT WS_VISIBLE
    LTEXT           "free", IDC_STT_FREE, 14, 132, 312, 10, NOT WS_VISIBLE

    GROUPBOX        "Language and port", IDC_G_STT_CONN, 7, 151, 326, 30, NOT WS_VISIBLE
    LTEXT           "Language", IDC_L_STT_LANG, 14, 164, 42, 10, NOT WS_VISIBLE
    COMBOBOX        IDC_STT_LANG, 58, 162, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | NOT WS_VISIBLE
    LTEXT           "Port", IDC_L_STT_PORT, 230, 164, 50, 10, NOT WS_VISIBLE
    EDITTEXT        IDC_STT_PORT, 284, 162, 42, 14, ES_NUMBER | NOT WS_VISIBLE

    GROUPBOX        "Key", IDC_G_STT_KEY, 7, 184, 326, 48, NOT WS_VISIBLE
    EDITTEXT        IDC_STT_KEY, 14, 195, 150, 14, ES_AUTOHSCROLL | ES_READONLY | ES_PASSWORD | NOT WS_VISIBLE
    PUSHBUTTON      "Show", IDC_STT_SHOWKEY, 168, 195, 46, 14, NOT WS_VISIBLE
    PUSHBUTTON      "Copy", IDC_STT_COPYKEY, 217, 195, 46, 14, NOT WS_VISIBLE
    PUSHBUTTON      "New", IDC_STT_NEWKEY, 266, 195, 60, 14, NOT WS_VISIBLE
    LTEXT           "hint", IDC_L_STT_KEY, 14, 212, 312, 18, NOT WS_VISIBLE

    AUTOCHECKBOX    "Start with the server", IDC_STT_AUTOSTART, 10, 237, 320, 18, BS_MULTILINE | BS_TOP | NOT WS_VISIBLE
    LTEXT           "local", IDC_L_STT_LOCAL, 10, 258, 320, 20, NOT WS_VISIBLE

    // Both pages
    AUTOCHECKBOX    "Autostart", IDC_AUTOSTART, 10, 297, 200, 10

    LTEXT           "Activity", IDC_L_ACTIVITY, 10, 310, 320, 10
    LISTBOX         IDC_ACTIVITY, 10, 320, 320, 24, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_BORDER

    LTEXT           "", IDC_MESSAGE, 10, 351, 200, 10
    DEFPUSHBUTTON   "Save", IDOK, 220, 349, 54, 14
    PUSHBUTTON      "Close", IDCANCEL, 278, 349, 54, 14

    // The tabs: a strip only, so each page draws on the window's own background. Last, so it is
    // at the bottom of the order and never paints over a page.
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 3, 4, 334, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "YaqaLab"
            VALUE "FileDescription", "Clew audio server"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "clew-audio-server"
            VALUE "OriginalFilename", "clew-audio-server.exe"
            VALUE "ProductName", "Clew"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
