// Texts are set at run time from src/win/strings.cpp (English or Japanese); the ones here are
// placeholders for the resource editor only.
#include <windows.h>
#include "resource.h"

IDI_APP       ICON "icons/app.ico"
IDI_TRAY_ON   ICON "icons/tray-on.ico"
IDI_TRAY_OFF  ICON "icons/tray-off.ico"
IDI_TRAY_BUSY ICON "icons/tray-busy.ico"

IDD_SETTINGS DIALOGEX 0, 0, 340, 404
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Clew audio server"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "status", IDC_STATUS, 10, 9, 262, 18
    PUSHBUTTON      "Stop", IDC_STARTSTOP, 278, 7, 52, 14

    GROUPBOX        "Folder", IDC_G_FOLDER, 7, 30, 326, 32
    EDITTEXT        IDC_FOLDER, 14, 42, 208, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse", IDC_BROWSE, 226, 42, 52, 14
    PUSHBUTTON      "Open", IDC_OPENFOLDER, 281, 42, 45, 14

    GROUPBOX        "Connection", IDC_G_CONN, 7, 66, 326, 90
    LTEXT           "Port", IDC_L_PORT, 14, 80, 40, 10
    EDITTEXT        IDC_PORT, 58, 78, 42, 14, ES_NUMBER
    LTEXT           "Hours", IDC_L_HOURS, 120, 80, 150, 10
    EDITTEXT        IDC_HOURS, 284, 78, 42, 14, ES_NUMBER
    LTEXT           "Origins", IDC_L_ORIGINS, 14, 96, 312, 18
    EDITTEXT        IDC_ORIGINS, 14, 116, 312, 34, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL

    GROUPBOX        "Secret", IDC_G_SECRET, 7, 160, 326, 50
    EDITTEXT        IDC_SECRET, 14, 172, 150, 14, ES_AUTOHSCROLL | ES_READONLY | ES_PASSWORD
    PUSHBUTTON      "Show", IDC_SHOW, 168, 172, 46, 14
    PUSHBUTTON      "Copy", IDC_COPY, 217, 172, 46, 14
    PUSHBUTTON      "New", IDC_NEWSECRET, 266, 172, 60, 14
    LTEXT           "hint", IDC_L_SECRET, 14, 190, 312, 18

    GROUPBOX        "Conversion", IDC_G_CONVERT, 7, 214, 326, 104
    AUTOCHECKBOX    "Convert", IDC_CONVERT, 14, 226, 312, 18, BS_MULTILINE | BS_TOP
    AUTOCHECKBOX    "Prepare", IDC_PREPARE, 14, 246, 312, 10
    LTEXT           "ffmpeg", IDC_L_FFMPEG, 14, 264, 66, 10
    EDITTEXT        IDC_FFMPEG, 82, 262, 140, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse", IDC_FFBROWSE, 226, 262, 52, 14
    PUSHBUTTON      "Find", IDC_FFFIND, 281, 262, 45, 14
    LTEXT           "hint", IDC_L_FFHINT, 82, 278, 244, 18
    LTEXT           "Cache", IDC_L_CACHE, 14, 300, 66, 10
    EDITTEXT        IDC_CACHEMB, 82, 298, 46, 14, ES_NUMBER
    LTEXT           "used", IDC_CACHEUSED, 134, 300, 120, 10
    PUSHBUTTON      "Clear", IDC_CLEARCACHE, 258, 298, 68, 14

    AUTOCHECKBOX    "Autostart", IDC_AUTOSTART, 10, 324, 200, 10

    LTEXT           "Activity", IDC_L_ACTIVITY, 10, 338, 320, 10
    LISTBOX         IDC_ACTIVITY, 10, 349, 320, 30, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_BORDER

    LTEXT           "", IDC_MESSAGE, 10, 386, 200, 10
    DEFPUSHBUTTON   "Save", IDOK, 220, 384, 54, 14
    PUSHBUTTON      "Close", IDCANCEL, 278, 384, 54, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "F. R. Andriariniaina"
            VALUE "FileDescription", "Clew audio server"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "clew-audio-server"
            VALUE "OriginalFilename", "clew-audio-server.exe"
            VALUE "ProductName", "Clew"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
