{
  "name": "clew-desktop",
  "productName": "Clew",
  "version": "0.2.0",
  "private": true,
  "description": "Clew and yaqatw as an installable desktop app, served under their real origins.",
  "license": "MIT",
  "main": "src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sources": "node scripts/fetch-sources.mjs",
    "build:sites": "node scripts/build-sites.mjs",
    "build:tools": "node scripts/build-tools.mjs",
    "build:word": "node scripts/build-word.mjs",
    "dist": "npm run sources && npm run build:sites && npm run build:tools && npm run build:word && electron-builder",
    "pack": "electron-builder --dir",
    "start": "node scripts/electron.mjs",
    "dev": "node scripts/dev.mjs",
    "smoke": "node scripts/electron.mjs --smoke",
    "test": "node --test test/*.test.js",
    "package:dictation": "node scripts/package-dictation.mjs"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "net.alefa.clew",
    "productName": "Clew",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "sites.config.json",
      "desktop.config.json",
      "!node_modules/better-sqlite3-multiple-ciphers/{deps,src}/**",
      "!node_modules/better-sqlite3-multiple-ciphers/binding.gyp"
    ],
    "afterPack": "build/after-pack.cjs",
    "extraResources": [
      {
        "from": "sites",
        "to": "sites",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "tools-dist",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "word-plugin/dist/yaqatw.dotm",
          "to": "word-plugin/yaqatw.dotm"
        }
      ],
      "files": [
        "src/**/*",
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{darwin,linux,linuxmusl}-*"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Clew-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Clew uses the camera when you scan a code or record an observation.",
        "NSMicrophoneUsageDescription": "Clew uses the microphone for dictation, recordings and calls."
      },
      "files": [
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{win32,linux,linuxmusl}-*"
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "files": [
        "!node_modules/better-sqlite3-multiple-ciphers/prebuilds/{win32,darwin}-*"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yaqalab",
        "repo": "clew-desktop",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3-multiple-ciphers/prebuilds/*.node"
    ]
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.2.0",
    "electron-updater": "6.8.11",
    "selfsigned": "5.5.0"
  }
}
